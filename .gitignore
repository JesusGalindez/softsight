# Dependencias y salidas de compilación
node_modules/
dist/
dist-node/
.cache/
.DS_Store

# Configuración local con rutas absolutas de la máquina. Solo lo local: lo que
# sea del proyecto —habilidades, ajustes compartidos— se puede versionar.
.claude/launch.json
.claude/settings.local.json
.claude/worktrees/

# Pliegos generados por el banco de agentes; los ejemplos JSON sí entran
artifacts/agent/*.png
artifacts/agent/*.obj

# Caché del modelo analizado: se rehace sola
.cache/

# El paquete cube-v1 lo escribe `npm run cube-v1` y es determinista: commitearlo
# sería un segundo original de lo que produce el generador
artifacts/cube-v1/
