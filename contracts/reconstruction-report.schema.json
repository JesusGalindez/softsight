{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JesusGalindez/softsight/contracts/reconstruction-report.schema.json",
  "title": "reconstruction-report",
  "type": "object",
  "properties": {
    "documentType": {
      "type": "string",
      "enum": [
        "softsight.reconstruction-report"
      ],
      "description": "Qué documento es. El informe de producción es otro distinto (D14)."
    },
    "contractVersion": {
      "type": "string",
      "description": "Versión del contrato del paquete que se evaluó."
    },
    "execution": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "ERROR",
        "UNSUPPORTED"
      ],
      "description": "Si el trabajo se pudo hacer. No dice nada sobre la geometría."
    },
    "certification": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ],
      "description": "Si lo medido cumple. Un eje aparte de la ejecución."
    },
    "certificationReason": {
      "type": "string",
      "description": "Motivo canónico cuando no es PASS; ausente cuando lo es."
    },
    "certificationPolicy": {
      "type": "string",
      "description": "Qué criterio se aplicó, para que un PASS de hoy y uno de mañana se puedan comparar."
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Qué tope es."
          },
          "value": {
            "type": "number",
            "description": "El número que rigió."
          },
          "unit": {
            "type": "string",
            "enum": [
              "bytes",
              "entradas",
              "líneas"
            ],
            "description": "En qué se cuenta."
          },
          "rationale": {
            "type": "string",
            "description": "Por qué ese número y no otro."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "rationale"
        ]
      },
      "description": "Topes de recurso aplicados, para que un rechazo por tamaño se pueda reproducir."
    },
    "extensions": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "description": "Qué se hace con una opcional desconocida."
        },
        "honoured": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extensiones que este binario entiende."
        },
        "ignored": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Opcionales desconocidas: preservadas en el paquete y nombradas aquí."
        }
      },
      "additionalProperties": false,
      "required": [
        "policy",
        "honoured",
        "ignored"
      ],
      "description": "Qué se hizo con el espacio de extensiones de D30, y con qué política."
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "description": "Qué se hace con una provista desconocida."
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lo que este binario sabe hacer; se publica aunque el paquete no pida nada."
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lo que el paquete exigía."
        },
        "provided": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lo que el paquete traía."
        },
        "unknownProvided": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "De lo que traía, lo que no conocemos: preservado y nombrado, nunca tirado en silencio."
        }
      },
      "additionalProperties": false,
      "required": [
        "policy",
        "supports",
        "required",
        "provided",
        "unknownProvided"
      ],
      "description": "La negociación de D31: qué sabe hacer este binario, qué pedía el paquete y qué traía."
    },
    "run": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "description": "Determinista: sale del manifest, no de un reloj."
        },
        "inputPackageId": {
          "type": "string",
          "description": "Identidad del paquete consumido."
        },
        "inputManifestSha256": {
          "type": "string",
          "description": "Hash del manifest evaluado."
        },
        "status": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "ERROR",
            "UNSUPPORTED"
          ],
          "description": "Estado del consumo."
        }
      },
      "additionalProperties": false,
      "required": [
        "runId",
        "inputManifestSha256",
        "status"
      ],
      "description": "El consumo, que pertenece al run y nunca al paquete: leerlo no lo modifica (D29)."
    },
    "versions": {
      "type": "object",
      "properties": {
        "softsight": {
          "type": "string",
          "description": "Versión del binario; no es un contrato."
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Qué contrato."
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "description": "Su versión."
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ]
          },
          "description": "Todas las versiones de contrato que rigieron, ordenadas por nombre. El consumidor comprueba la combinación y no un campo: dos versiones que por separado existen pueden no haberse visto nunca juntas, y es ahí donde se rompe sin que nadie sepa por qué (D12)."
        }
      },
      "additionalProperties": false,
      "required": [
        "softsight",
        "contracts"
      ],
      "description": "Bloque de versiones; el consumidor comprueba el bloque, no un campo (D12)."
    },
    "evidence": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Identidad del artifact."
              },
              "type": {
                "type": "string",
                "description": "Tipo declarado en el paquete."
              },
              "sha256": {
                "type": "string",
                "description": "Hash comprobado, no copiado."
              },
              "bytes": {
                "type": "number",
                "description": "Tamaño comprobado."
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "sha256",
              "bytes"
            ]
          },
          "description": "Artifacts admitidos y medidos."
        },
        "requiredEvidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lo que el paquete declaró como imprescindible."
        },
        "missingEvidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "De lo anterior, lo que no llegó. Con algo aquí, el veredicto es INCONCLUSIVE (D8)."
        }
      },
      "additionalProperties": false,
      "required": [
        "artifacts",
        "requiredEvidence",
        "missingEvidence"
      ],
      "description": "A qué apunta este informe, con hash por artifact (P5)."
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "appliesTo": {
            "type": "object",
            "properties": {
              "artifactId": {
                "type": "string",
                "description": "Artifact medido."
              },
              "sha256": {
                "type": "string",
                "description": "Su hash, el comprobado en la ingesta."
              }
            },
            "additionalProperties": false,
            "required": [
              "artifactId",
              "sha256"
            ],
            "description": "Sobre qué corrió la medida."
          },
          "purelyReconstructed": {
            "type": "boolean",
            "description": "Provenance de esa malla, copiada de su artifact (D21)."
          },
          "vertices": {
            "type": "number",
            "description": "Vértices del fichero, sin soldar."
          },
          "triangles": {
            "type": "number",
            "description": "Triángulos del fichero."
          },
          "degenerateTriangles": {
            "type": "number",
            "description": "De área nula."
          },
          "duplicatePositions": {
            "type": "number",
            "description": "Vértices que la soldadura junta."
          },
          "boundaryEdges": {
            "type": "number",
            "description": "Aristas con un solo triángulo."
          },
          "nonManifoldEdges": {
            "type": "number",
            "description": "Aristas con tres o más."
          },
          "watertight": {
            "type": "boolean",
            "description": "Cerrada tras soldar."
          },
          "signedVolume": {
            "type": "number",
            "description": "Volumen firmado; negativo es del revés."
          },
          "boundingBoxMin": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Esquina mínima de la caja."
          },
          "boundingBoxMax": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Esquina máxima."
          },
          "frame": {
            "type": "string",
            "description": "Marco en el que están estos números (D11)."
          },
          "measurementClass": {
            "type": "string",
            "enum": [
              "EXACT",
              "DETERMINISTIC_APPROXIMATION",
              "EXTERNAL_MEASUREMENT"
            ],
            "description": "Qué clase de medida es (D28). Recuentos y caja son exactos."
          },
          "reproducibility": {
            "type": "string",
            "enum": [
              "BITWISE_EXACT",
              "QUANTIZED",
              "TOLERANCE"
            ],
            "description": "Con qué reproducibilidad. Nace BITWISE_EXACT y moverla exige medida."
          }
        },
        "additionalProperties": false,
        "required": [
          "appliesTo",
          "purelyReconstructed",
          "vertices",
          "triangles",
          "degenerateTriangles",
          "duplicatePositions",
          "boundaryEdges",
          "nonManifoldEdges",
          "watertight",
          "signedVolume",
          "boundingBoxMin",
          "boundingBoxMax",
          "frame",
          "measurementClass",
          "reproducibility"
        ]
      },
      "description": "Una entrada por malla medida, cada una atada a su artifact."
    },
    "frames": {
      "type": "object",
      "properties": {
        "measuredIn": {
          "type": "string",
          "description": "Marco de los números de `measurements`."
        },
        "declared": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Marcos que nombra el grafo."
        },
        "reachable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "De ellos, a los que hay camino."
        },
        "transforms": {
          "type": "number",
          "description": "Aristas declaradas."
        }
      },
      "additionalProperties": false,
      "required": [
        "measuredIn",
        "declared",
        "reachable",
        "transforms"
      ],
      "description": "El grafo de marcos que rigió (D11): dónde se midió, qué marcos declara el paquete y a cuáles hay camino. Un declarado que no esté en `reachable` es un salto que nadie registró."
    },
    "coverage": {
      "type": "object",
      "properties": {
        "measurementClass": {
          "type": "string",
          "description": "APPROXIMATE: el muestreo no visita toda la superficie."
        },
        "reproducibility": {
          "type": "string",
          "description": "BITWISE_EXACT: visita siempre los mismos puntos."
        },
        "seed": {
          "type": "number",
          "description": "Semilla del muestreo; sin ella no se reproduce."
        },
        "samples": {
          "type": "number",
          "description": "Muestras que sostienen los ratios (§86.3 k)."
        },
        "areaWeighted": {
          "type": "boolean",
          "description": "Siempre cierto; se declara en vez de suponerse."
        },
        "observedAreaRatio": {
          "type": "number",
          "description": "Área que ve al menos una cámara."
        },
        "triangulatedAreaRatio": {
          "type": "number",
          "description": "La que ven dos o más."
        },
        "weakAreaRatio": {
          "type": "number",
          "description": "La que ve exactamente una: hay foto y no hay profundidad."
        },
        "unobservedAreaRatio": {
          "type": "number",
          "description": "La que no ve ninguna."
        },
        "standardError": {
          "type": "number",
          "description": "Error estándar del ratio observado."
        },
        "interval": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Dos sigmas, recortado a [0,1]."
        },
        "bySeenBy": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Muestras por número de cámaras que las ven."
        },
        "maskedCameras": {
          "type": "number",
          "description": "De cuántas cámaras se aplicó la silueta. Cero significa que el número es puramente geométrico y **cuenta como observada la superficie que proyecta sobre el fondo**; no significa que no hubiera fondo."
        },
        "provenanceAware": {
          "type": "boolean",
          "description": "Falso en v1, y se dice (D21)."
        },
        "certificationEligible": {
          "type": "boolean",
          "description": "Si el número certifica o solo se reporta."
        },
        "reason": {
          "type": "string",
          "description": "Motivo cuando no certifica; ausente cuando sí."
        }
      },
      "additionalProperties": false,
      "required": [
        "measurementClass",
        "reproducibility",
        "seed",
        "samples",
        "areaWeighted",
        "observedAreaRatio",
        "triangulatedAreaRatio",
        "weakAreaRatio",
        "unobservedAreaRatio",
        "standardError",
        "interval",
        "bySeenBy",
        "maskedCameras",
        "provenanceAware",
        "certificationEligible"
      ],
      "description": "Qué parte de la superficie sostiene la evidencia (R6). **Ausente** cuando no hay malla o no hay cámaras: no es cero, es que la pregunta no se puede hacer."
    },
    "confidence": {
      "type": "object",
      "properties": {
        "measurementClass": {
          "type": "string",
          "description": "APPROXIMATE."
        },
        "reproducibility": {
          "type": "string",
          "description": "BITWISE_EXACT."
        },
        "seed": {
          "type": "number",
          "description": "Semilla del muestreo."
        },
        "samples": {
          "type": "number",
          "description": "Muestras que sostienen las clases."
        },
        "areaWeighted": {
          "type": "boolean",
          "description": "Siempre cierto."
        },
        "parallaxThresholdDegrees": {
          "type": "number",
          "description": "El suelo que se aplicó; las clases dependen de él."
        },
        "byClass": {
          "type": "object",
          "properties": {
            "SIN_EVIDENCIA": {
              "type": "number",
              "description": "Ninguna cámara la ve."
            },
            "SIN_TRIANGULAR": {
              "type": "number",
              "description": "La ve una."
            },
            "PARALAJE_CORTO": {
              "type": "number",
              "description": "Dos o más demasiado juntas."
            },
            "SOSTENIDA": {
              "type": "number",
              "description": "Dos o más con ángulo suficiente."
            }
          },
          "additionalProperties": false,
          "required": [
            "SIN_EVIDENCIA",
            "SIN_TRIANGULAR",
            "PARALAJE_CORTO",
            "SOSTENIDA"
          ],
          "description": "Fracción de área por clase. Suman uno. **No hay número agregado**: un índice medio escondería que la mitad firme y la mitad sin evidencia dan lo mismo que todo mediocre."
        },
        "parallaxDegrees": {
          "type": "object",
          "properties": {
            "p05": {
              "type": "number",
              "description": "Percentil 5."
            },
            "median": {
              "type": "number",
              "description": "Mediana."
            },
            "p95": {
              "type": "number",
              "description": "Percentil 95."
            }
          },
          "additionalProperties": false,
          "required": [
            "p05",
            "median",
            "p95"
          ],
          "description": "Percentiles del ángulo de triangulación, solo sobre lo que triangula. Nulo si nada triangula: «no hay ángulo» no es «el ángulo es cero»."
        },
        "obliquityDegrees": {
          "type": "object",
          "properties": {
            "median": {
              "type": "number",
              "description": "Mediana."
            },
            "p95": {
              "type": "number",
              "description": "Percentil 95."
            }
          },
          "additionalProperties": false,
          "required": [
            "median",
            "p95"
          ],
          "description": "Percentiles de la oblicuidad de la mejor vista, en grados desde la normal."
        },
        "groundSampling": {
          "type": "object",
          "properties": {
            "median": {
              "type": "number",
              "description": "Mediana."
            },
            "p95": {
              "type": "number",
              "description": "Percentil 95."
            }
          },
          "additionalProperties": false,
          "required": [
            "median",
            "p95"
          ],
          "description": "Unidades del paquete por píxel en la mejor vista. Con escala desconocida es relativo, y por eso va la diagonal al lado (D9)."
        },
        "provenanceAware": {
          "type": "boolean",
          "description": "Falso en v1 (D21)."
        },
        "certificationEligible": {
          "type": "boolean",
          "description": "Si certifica o solo se reporta."
        },
        "reason": {
          "type": "string",
          "description": "Motivo cuando no certifica."
        }
      },
      "additionalProperties": false,
      "required": [
        "measurementClass",
        "reproducibility",
        "seed",
        "samples",
        "areaWeighted",
        "parallaxThresholdDegrees",
        "byClass",
        "provenanceAware",
        "certificationEligible"
      ],
      "description": "Desde dónde se miró cada región (R6). Ausente por lo mismo que `coverage`."
    },
    "repairBoundary": {
      "type": "object",
      "properties": {
        "measurementClass": {
          "type": "string",
          "enum": [
            "EXACT",
            "APPROXIMATE"
          ],
          "description": "APPROXIMATE en cuanto hay un agujero que clasificar: eso cuelga del muestreo de R6."
        },
        "reproducibility": {
          "type": "string",
          "description": "BITWISE_EXACT."
        },
        "evidenceAware": {
          "type": "boolean",
          "description": "Si se pudo cruzar con las cámaras. Falso deja todos los agujeros en REVIEW: **no saber no es estar bien**."
        },
        "omittedLoops": {
          "type": "number",
          "description": "Agujeros que no entraron en la lista por el tope. El recorte va por riesgo primero y por tamaño después, así que lo inseguro nunca se cae por pequeño; y `byRisk` los cuenta igual."
        },
        "byRisk": {
          "type": "object",
          "properties": {
            "SAFE": {
              "type": "number",
              "description": "No mueven ninguna superficie."
            },
            "REVIEW": {
              "type": "number",
              "description": "Mueven o crean superficie donde alguien miró."
            },
            "UNSAFE": {
              "type": "number",
              "description": "Crean superficie donde nadie miró."
            }
          },
          "additionalProperties": false,
          "required": [
            "SAFE",
            "REVIEW",
            "UNSAFE"
          ],
          "description": "Cuántas de cada clase **en total**, incluidas las que no se publican."
        },
        "repairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "defect": {
                "type": "string",
                "description": "Qué está mal."
              },
              "repair": {
                "type": "string",
                "description": "Qué haría la reparación, nombrada: sin esto el riesgo no se puede juzgar."
              },
              "risk": {
                "type": "string",
                "enum": [
                  "SAFE",
                  "REVIEW",
                  "UNSAFE"
                ],
                "description": "SAFE no mueve superficie; REVIEW la mueve o la crea donde hay fotos que pueden desmentirla; UNSAFE la crea donde no las hay, y entonces salga como salga nadie podrá saberlo."
              },
              "reason": {
                "type": "string",
                "description": "Motivo canónico del veredicto."
              },
              "breaksPurelyReconstructed": {
                "type": "boolean",
                "description": "Si hacerla fuerza `purelyReconstructed` a false. Es la consecuencia mecánica: con ella, D21 deja de certificar. No es una etiqueta de color — dice qué pierde el paquete."
              },
              "evidence": {
                "type": "object",
                "description": "Los números que sostienen el veredicto, para no obligar a recalcularlos (§53)."
              }
            },
            "additionalProperties": false,
            "required": [
              "defect",
              "repair",
              "risk",
              "reason",
              "breaksPurelyReconstructed",
              "evidence"
            ]
          },
          "description": "Una entrada por defecto, y **una por agujero**: el mismo defecto vale cosas distintas según quién miró ahí."
        }
      },
      "additionalProperties": false,
      "required": [
        "measurementClass",
        "reproducibility",
        "evidenceAware",
        "omittedLoops",
        "byRisk",
        "repairs"
      ],
      "description": "Qué se puede reparar sin inventar nada (R10). **No repara**: dice, defecto a defecto, qué arriesga quien lo repare. Ausente cuando no hay malla medida — sin superficie no hay defecto que reparar, y una lista vacía diría que no hay ninguno."
    },
    "budgets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "El nombre declarado, tal cual."
          },
          "max": {
            "type": "number",
            "description": "El máximo declarado."
          },
          "units": {
            "type": "string",
            "enum": [
              "ABSOLUTE",
              "RELATIVE_TO_DIAGONAL"
            ],
            "description": "Cómo se expresa el máximo."
          },
          "unit": {
            "type": "string",
            "description": "La unidad, cuando es absoluto."
          },
          "observed": {
            "type": "number",
            "description": "Lo medido en el paquete. Ausente cuando no se pudo evaluar."
          },
          "measures": {
            "type": "string",
            "description": "Qué mide el término, copiado del vocabulario: leer el informe no obliga a buscarlo."
          },
          "verdict": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NO_EVALUADO"
            ],
            "description": "`NO_EVALUADO` **no es aprobado**: el informe dice término a término cuál se juzgó y cuál no."
          },
          "reason": {
            "type": "string",
