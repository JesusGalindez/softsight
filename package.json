{
  "name": "softsight",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "verify": "tsc --noEmit && npm run test:animation",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:agent3d": "vite build --config vite.node.config.ts",
    "test:animation": "node tools/run-tests.mjs",
    "test:gltf-frame": "npm run build:agent3d && node tools/gltf-frame.test.mjs",
    "test:glb-writer": "npm run build:agent3d && node tools/glb-writer.test.mjs",
    "test:bvh": "npm run build:agent3d && node tools/bvh-loader.test.mjs",
    "test:bind": "npm run build:agent3d && node tools/skin-binding.test.mjs",
    "test:blend-contract": "npm run build:agent3d && node tools/blend-contract.test.mjs",
    "test:rig": "npm run build:agent3d && node tools/rig-spec.test.mjs",
    "test:story": "npm run build:agent3d && node tools/story-spec.test.mjs",
    "test:geometry": "npm run build:agent3d && node tools/geometry.test.mjs",
    "test:bridge": "npm run build:agent3d && node tools/bridge.test.mjs",
    "test:codes": "npm run build:agent3d && node tools/warning-codes.test.mjs",
    "test:summary": "npm run build:agent3d && node tools/summary.test.mjs",
    "test:mcp": "npm run build:agent3d && node tools/mcp.test.mjs",
    "test:incremental": "npm run build:agent3d && node tools/incremental.test.mjs",
    "test:screen": "npm run build:agent3d && node tools/screen-audit.test.mjs",
    "test:framing": "npm run build:agent3d && node tools/framing.test.mjs",
    "test:agents-md": "npm run build:agent3d && node tools/agents-md.mjs --check",
    "test:worker": "npm run build:agent3d && node tools/worker.test.mjs",
    "test:model-cache": "npm run build:agent3d && node tools/model-cache.test.mjs",
    "test:colmap": "npm run build:agent3d && node tools/colmap.test.mjs",
    "test:contracts": "npm run build:agent3d && node tools/contracts.test.mjs",
    "reconstruction": "npm run build:agent3d && node tools/reconstruction.mjs",
    "colmap-small-v1": "node tools/colmapSmall.mjs",
    "cube-v1": "npm run build:agent3d && node tools/cubeV1.mjs",
    "test:report-r7": "npm run build:agent3d && node tools/report-r7.test.mjs",
    "test:confidence": "npm run build:agent3d && node tools/confidence.test.mjs",
    "test:coverage": "npm run build:agent3d && node tools/coverage.test.mjs",
    "test:masks": "npm run build:agent3d && node tools/masks.test.mjs",
    "test:parity": "npm run build:agent3d && node tools/parity.test.mjs",
    "test:capture-advice": "npm run build:agent3d && node tools/capture-advice.test.mjs",
    "test:budgets": "npm run build:agent3d && node tools/budgets.test.mjs",
    "test:candidates": "npm run build:agent3d && node tools/candidates.test.mjs",
    "test:repair": "npm run build:agent3d && node tools/repair.test.mjs",
    "test:production": "npm run build:agent3d && node tools/production.test.mjs",
    "test:lod-qa": "npm run build:agent3d && node tools/lod-qa.test.mjs",
    "test:uv-qa": "npm run build:agent3d && node tools/uv-qa.test.mjs",
    "test:texture-qa": "npm run build:agent3d && node tools/texture-qa.test.mjs",
    "test:collision-qa": "npm run build:agent3d && node tools/collision-qa.test.mjs",
    "test:producer-colmap": "npm run build:agent3d && node tools/producer-colmap.test.mjs",
    "test:producer-superficie": "npm run build:agent3d && node tools/producer-superficie.test.mjs",
    "colmap-v1": "node producers/colmap/build.mjs",
    "superficie-v1": "node producers/superficie/build.mjs",
    "esfera-v1": "npm run build:agent3d && node tools/productionAsset.mjs",
    "production": "npm run build:agent3d && node tools/production.mjs",
    "test:self-intersection": "npm run build:agent3d && node tools/self-intersection.test.mjs",
    "test:mesh-topology": "npm run build:agent3d && node tools/mesh-topology.test.mjs",
    "test:mesh-diff": "npm run build:agent3d && node tools/mesh-diff.test.mjs",
    "test:bands": "npm run build:agent3d && node tools/bands.test.mjs",
    "test:bounds-tree": "npm run build:agent3d && node tools/bounds-tree.test.mjs",
    "test:reconstruction": "npm run build:agent3d && node tools/reconstruction.test.mjs",
    "test:resources": "npm run build:agent3d && node tools/resources.test.mjs",
    "test:determinism": "npm run build:agent3d && node tools/render-hashes.mjs",
    "bridge": "node tools/bridge.mjs",
    "worker": "node tools/workerServer.mjs",
    "filmstrip": "npm run build:agent3d --silent && node tools/filmstrip.mjs",
    "agent3d": "vite build --config vite.node.config.ts --logLevel error 1>&2 && node tools/agent3d.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:text": "npm run build:agent3d && node tools/text.test.mjs",
    "test:text-plan": "npm run build:agent3d && node tools/text-plan.test.mjs"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "optionalDependencies": {
    "meshoptimizer": "^0.22.0"
  },
  "description": "Software 3D rasterizer with an agent workbench. No GPU, no dependencies. Loads GLB/OBJ, renders contact sheets, audits topology, applies patches — headless, deterministic, JSON in and out.",
  "license": "Apache-2.0",
  "author": "Jesús Galindez",
  "repository": {
    "type": "git",
    "url": "https://github.com/JesusGalindez/softsight.git"
  },
  "keywords": [
    "software-rendering",
    "rasterizer",
    "3d",
    "gltf",
    "glb",
    "obj",
    "ai-agents",
    "headless",
    "no-gpu",
    "typescript",
    "deterministic"
  ]
}
